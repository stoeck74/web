---
import { ClientRouter } from 'astro:transitions';
// Archivo variable avec l'axe de largeur (wdth) : un seul fichier pour le texte et les titres étroits
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';

interface Props {
  title: string;
  description?: string;
  /** Identifiant de la page, utilisé pour lancer le JS propre à chaque page */
  namespace: string;
}

const {
  title,
  description = 'CSS — Cédric Stoecklin Studio, studio de création web pour architectes et photographes.',
  namespace,
} = Astro.props;

const fullTitle =
  title === 'Accueil'
    ? 'CSS — Cédric Stoecklin Studio · Sites web pour architectes & photographes'
    : `${title} — CSS Cédric Stoecklin Studio`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Loader : false = joué à chaque chargement (pendant le dev),
// true = une seule fois par session (à remettre pour la mise en ligne)
const introOncePerSession = false;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- .js : masque le contenu avant l'animation d'entrée (uniquement si JS est actif)
         .intro-seen : le loader complet ne se joue qu'une fois par session -->
    <script is:inline define:vars={{ introOncePerSession }}>
      (function () {
        var c = document.documentElement.classList;
        c.add('js');
        if (!introOncePerSession) return;
        try { if (sessionStorage.getItem('css-intro-seen')) c.add('intro-seen'); } catch (e) {}
      })();
    </script>

    <ClientRouter fallback="swap" />
  </head>
  <body>
    <Loader />
    <Header />

    <main data-page data-namespace={namespace} class="min-h-svh">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>