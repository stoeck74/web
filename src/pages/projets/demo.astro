---
import Base from '../../layouts/Base.astro';
---

<Base title="Projet démo" namespace="project">
  <article class="px-6 pb-32 pt-40 md:px-10">
    <a href="/" class="mb-10 inline-block text-sm text-muted hover:text-ink" data-reveal>← Tous les projets</a>
    <h1 class="mb-6 text-5xl font-medium tracking-tight md:text-7xl" data-reveal>Projet démo</h1>
    <p class="max-w-xl text-lg text-muted" data-reveal>
      Page de test des transitions : navigue entre l'accueil et cette page,
      puis teste les boutons précédent/suivant du navigateur.
    </p>

    <div class="mt-16 aspect-[16/9] w-full bg-ink/10" data-reveal></div>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div class="aspect-[4/5] bg-ink/10" data-reveal></div>
      <div class="aspect-[4/5] bg-ink/10" data-reveal></div>
    </div>
  </article>
</Base>
